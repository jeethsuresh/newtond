{
  "schema": 1,
  "image_repository": "ghcr.io/jeethsuresh/newtond-private",
  "image_pull_secret": "gravitas-ghcr",
  "runtime_secret": "newtond-runtime",
  "cpu": "50m",
  "memory": "128Mi",
  "storage": {
    "size": "5Gi",
    "mount": "/data"
  },
  "env": {
    "NEWTOND_PUBLIC_ORIGIN": "https://newtond.gravitas.cool"
  },
  "test_target": "test",
  "verify": [
    {
      "path": "/api/v1/query",
      "status": 401,
      "cache_control_contains": "no-store"
    }
  ],
  "release": {
    "command": [
      "bash",
      "deploy/gravitas.sh"
    ]
  }
}
